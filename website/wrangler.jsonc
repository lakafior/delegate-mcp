{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delegate",
  "compatibility_date": "2026-10-26",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "."
  },
  // A route, not a custom domain: a custom domain gets its own certificate that also covers smigi.net,
  // and browsers reusing one connection across *.smigi.net then get 421 Misdirected Request. A route
  // uses the zone's *.smigi.net certificate. It needs a proxied DNS record (AAAA 100::) for the host.
  "routes": [
    { "pattern": "delegate.smigi.net/*", "zone_name": "smigi.net" }
  ]
}
